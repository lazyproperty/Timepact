<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Privacy Policy — Timepact</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Cinzel:wght@400;600&family=Inter:wght@300;400&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg-top:    #FCEFEC;
    --bg-mid:    #F7F2EB;
    --bg-bot:    #F2EDE0;
    --brown:     #52330F;
    --amber:     #9B6A1E;
    --amber-dim: rgba(155,106,30,0.25);
    --text:      rgba(82,51,15,0.85);
    --muted:     rgba(82,51,15,0.50);
    --dim:       rgba(82,51,15,0.08);
    --card-bg:   rgba(255,255,255,0.55);
  }

  html { scroll-behavior: smooth; }

  body {
    background: linear-gradient(180deg, var(--bg-top) 0%, var(--bg-mid) 50%, var(--bg-bot) 100%);
    background-attachment: fixed;
    color: var(--text);
    font-family: 'Inter', sans-serif;
    font-weight: 300;
    overflow-x: hidden;
    min-height: 100vh;
  }

  .bg-columns {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .col-left, .col-right {
    position: absolute;
    top: 0;
    width: 210px;
    display: flex;
    flex-direction: column;
  }
  .col-left  { left: 0; }
  .col-right { right: 0; text-align: right; }

  .era-item {
    padding: 16px 18px;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 13px;
    line-height: 1.55;
    color: var(--brown);
    opacity: 0;
    transition: opacity 2s ease;
  }

  .era-item.visible { opacity: 0.30; }
  .era-item.bright  { opacity: 0.55; }

  .era-item .year {
    font-family: 'Cinzel', serif;
    font-style: normal;
    font-size: 9px;
    letter-spacing: 0.14em;
    color: var(--amber);
    display: block;
    margin-bottom: 3px;
  }

  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 40px;
    background: linear-gradient(to bottom, rgba(252,239,236,0.97) 0%, rgba(252,239,236,0) 100%);
    backdrop-filter: blur(2px);
  }

  .nav-logo {
    font-family: 'Cinzel', serif;
    font-size: 17px;
    letter-spacing: 0.25em;
    color: var(--amber);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
  }
  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.3s;
  }
  .nav-links a:hover { color: var(--amber); }

  .lang-select {
    background: transparent;
    border: 1px solid var(--amber-dim);
    color: var(--muted);
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 0.08em;
    padding: 5px 10px;
    cursor: pointer;
    border-radius: 2px;
    outline: none;
    transition: border-color 0.3s, color 0.3s;
  }
  .lang-select:hover { border-color: var(--amber); color: var(--amber); }
  .lang-select option { background: #f7f2eb; }

  main { position: relative; z-index: 10; }

  section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 120px 260px 80px;
    max-width: 1400px;
    margin: 0 auto;
  }

  @media (max-width: 1100px) { section { padding: 100px 160px 60px; } }
  @media (max-width: 800px)  {
    section { padding: 100px 36px 60px; }
    .col-left, .col-right { width: 100px; }
    .era-item { font-size: 11px; padding: 12px 10px; }
    .nav-links { gap: 16px; }
  }

  .section-label {
    font-family: 'Cinzel', serif;
    font-size: 9px;
    letter-spacing: 0.35em;
    color: var(--amber);
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  p {
    font-size: 15px;
    line-height: 1.85;
    color: var(--muted);
    max-width: 580px;
    margin-bottom: 18px;
  }

  .privacy-block { margin-bottom: 32px; }
  .privacy-block h3 {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--brown);
    margin-bottom: 10px;
    text-transform: uppercase;
  }
  .privacy-block p { max-width: 660px; }
  .privacy-link { color: var(--amber); text-decoration: none; }
  .privacy-link:hover { text-decoration: underline; }

  footer {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 36px;
    border-top: 1px solid var(--dim);
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.1em;
  }

  .il { display: none; }
  .il.active { display: inline; }
</style>
</head>
<body>

<div class="bg-columns">
  <div class="col-left" id="colLeft"></div>
  <div class="col-right" id="colRight"></div>
</div>

<nav>
  <a href="/Timepact/" class="nav-logo">TIMEPACT</a>
  <ul class="nav-links">
    <li><a href="/Timepact/#about">About</a></li>
    <li><a href="/Timepact/#features">Features</a></li>
    <li><a href="/Timepact/#contact">Contact</a></li>
    <li><a href="privacy.html" style="color:var(--amber);">Privacy</a></li>
    <li><a href="terms.html">Terms</a></li>
    <li>
      <select class="lang-select" id="langSelect">
        <option value="en">EN</option>
        <option value="de">DE</option>
        <option value="es">ES</option>
        <option value="zh">中文</option>
        <option value="ru">RU</option>
      </select>
    </li>
  </ul>
</nav>

<main>
<section style="min-height:100vh;padding:140px 260px 80px;max-width:1400px;margin:0 auto;">
  <p class="section-label">Privacy Policy</p>
  <h1 style="font-family:'Cinzel',serif;font-size:clamp(32px,5vw,56px);font-weight:600;color:var(--brown);line-height:1;letter-spacing:0.06em;margin-bottom:30px;">Your data stays on your device</h1>

  <div class="privacy-block">
    <h3>Local Storage</h3>
    <p>All events, collections, and settings you create are stored locally on your device using Apple's CoreData framework. You have full control over your data.</p>
  </div>

  <div class="privacy-block" style="border-left:3px solid var(--amber);padding-left:20px;background:var(--card-bg);border-radius:4px;">
    <h3>iCloud Sync (CloudKit)</h3>
    <p><strong>If you're signed into iCloud</strong>, your events and collections sync privately to your own iCloud account via Apple's CloudKit. This allows you to access your data across all your Apple devices.</p>
    <p><strong>Important</strong>: This data is <strong>not accessible to the developer</strong> and is <strong>not shared with any third parties</strong>. It remains under your iCloud account and is subject to Apple's privacy policy. You can disable iCloud sync at any time in your device settings.</p>
  </div>

  <div class="privacy-block">
    <h3>Wikipedia API</h3>
    <p>When searching for events or viewing "On This Day", the app makes requests to the public Wikipedia API. These requests contain no personal identifiers. No search history is stored or transmitted.</p>
  </div>

  <div class="privacy-block">
    <h3>No Third Parties</h3>
    <p>Timepact contains no advertising SDKs, no analytics trackers, and no third-party data sharing of any kind. We do not sell, rent, or trade your information.</p>
    <p><strong>Future note</strong>: If we ever introduce ads or analytics, this policy will be updated and you will be notified.</p>
  </div>

  <div class="privacy-block">
    <h3>Contact</h3>
    <p>Privacy questions: <a href="mailto:lazyproperty@icloud.com" class="privacy-link">lazyproperty@icloud.com</a></p>
  </div>

  <div class="privacy-block" style="margin-top:40px;padding-top:30px;border-top:1px solid var(--dim);font-size:13px;color:var(--muted);">
    <p><strong>GDPR (Europe)</strong>: Since we don't collect personal data, there's nothing to export or delete. All your data stays on your device and iCloud account.</p>
    <p><strong>CCPA (California)</strong>: We don't sell personal information. We don't share data with third parties.</p>
    <p><strong>Children's privacy</strong>: Timepact is not directed at children under 13, but contains only educational content with no data collection.</p>
    <p style="margin-top:12px;"><em>Last updated: August 2026</em></p>
  </div>
</section>
</main>

<footer>
  <span style="font-family:'Cinzel',serif;letter-spacing:0.22em;color:var(--amber)">TIMEPACT</span>
  &nbsp;·&nbsp;
  <a href="privacy.html" style="color:var(--muted);text-decoration:none;">Privacy</a>
  &nbsp;·&nbsp;
  <a href="terms.html" style="color:var(--muted);text-decoration:none;">Terms</a>
  &nbsp;·&nbsp;
  <span id="fyear"></span>
</footer>

<script>
const EVENTS = [
  { year:"4.6 Ga", t:{en:"Formation of Earth",de:"Entstehung der Erde",es:"Formación de la Tierra",zh:"地球形成",ru:"Формирование Земли"} },
  { year:"4.1 Ga", t:{en:"First liquid water",de:"Erstes flüssiges Wasser",es:"Primera agua líquida",zh:"最早的液态水",ru:"Первая жидкая вода"} },
  { year:"3.8 Ga", t:{en:"First life — prokaryotes",de:"Erstes Leben",es:"Primera vida",zh:"最早的生命",ru:"Первая жизнь"} },
  { year:"2.4 Ga", t:{en:"Great Oxidation Event",de:"Große Oxidation",es:"Gran Oxidación",zh:"大氧化事件",ru:"Великое окисление"} },
  { year:"750 Ma", t:{en:"Snowball Earth",de:"Schneeball Erde",es:"Tierra bola de nieve",zh:"雪球地球",ru:"Земля-снежок"} },
  { year:"541 Ma", t:{en:"Cambrian explosion",de:"Kambrische Explosion",es:"Explosión cámbrica",zh:"寒武纪大爆发",ru:"Кембрийский взрыв"} },
  { year:"375 Ma", t:{en:"First tetrapods on land",de:"Erste Tetrapoden",es:"Primeros tetrápodos",zh:"首批四足动物",ru:"Первые тетраподы"} },
  { year:"252 Ma", t:{en:"Permian extinction",de:"Perm-Aussterben",es:"Extinción del Pérmico",zh:"二叠纪大灭绝",ru:"Пермское вымирание"} },
  { year:"230 Ma", t:{en:"First dinosaurs",de:"Erste Dinosaurier",es:"Primeros dinosaurios",zh:"最早的恐龙",ru:"Первые динозавры"} },
  { year:"66 Ma",  t:{en:"End of dinosaurs",de:"Ende der Dinosaurier",es:"Fin de los dinosaurios",zh:"恐龙灭绝",ru:"Гибель динозавров"} },
  { year:"55 Ma",  t:{en:"First primates",de:"Erste Primaten",es:"Primeros primates",zh:"最早的灵长类",ru:"Первые приматы"} },
  { year:"6 Ma",   t:{en:"Human–chimp split",de:"Mensch-Schimpansen-Split",es:"Separación humano-chimpancé",zh:"人类与黑猩猩分化",ru:"Разделение человека и шимпанзе"} },
  { year:"300 Ka", t:{en:"Homo sapiens appears",de:"Homo sapiens erscheint",es:"Aparece Homo sapiens",zh:"智人出现",ru:"Появление Homo sapiens"} },
  { year:"70 Ka",  t:{en:"Out of Africa",de:"Aus-Afrika-Migration",es:"Migración fuera de África",zh:"走出非洲",ru:"Миграция из Африки"} },
  { year:"12 Ka",  t:{en:"End of last ice age",de:"Ende der Eiszeit",es:"Fin de la glaciación",zh:"末次冰期结束",ru:"Конец ледникового периода"} },
  { year:"10 Ka",  t:{en:"Agricultural revolution",de:"Agrarrevolution",es:"Revolución agrícola",zh:"农业革命",ru:"Аграрная революция"} },
  { year:"3500 BCE",t:{en:"Writing invented in Sumer",de:"Schrift in Sumer",es:"Escritura en Sumer",zh:"苏美尔文字",ru:"Письменность в Шумере"} },
  { year:"2560 BCE",t:{en:"Great Pyramid of Giza",de:"Große Pyramide",es:"Gran Pirámide",zh:"吉萨大金字塔",ru:"Пирамида в Гизе"} },
  { year:"776 BCE", t:{en:"First Olympic Games",de:"Erste Olympische Spiele",es:"Primeros Juegos Olímpicos",zh:"第一届奥运会",ru:"Первые Олимпийские игры"} },
  { year:"44 BCE",  t:{en:"Assassination of Caesar",de:"Ermordung Cäsars",es:"Asesinato de César",zh:"恺撒遇刺",ru:"Убийство Цезаря"} },
  { year:"476 CE",  t:{en:"Fall of Western Rome",de:"Untergang Westroms",es:"Caída de Roma",zh:"西罗马灭亡",ru:"Падение Западного Рима"} },
  { year:"1066 CE", t:{en:"Battle of Hastings",de:"Schlacht bei Hastings",es:"Batalla de Hastings",zh:"黑斯廷斯战役",ru:"Битва при Гастингсе"} },
  { year:"1440 CE", t:{en:"Gutenberg's press",de:"Gutenbergs Druckpresse",es:"Imprenta de Gutenberg",zh:"古腾堡印刷机",ru:"Печатный станок Гутенберга"} },
  { year:"1492 CE", t:{en:"Columbus reaches Americas",de:"Kolumbus in Amerika",es:"Colón llega a América",zh:"哥伦布抵达美洲",ru:"Колумб достигает Америки"} },
  { year:"1687 CE", t:{en:"Newton's Principia",de:"Newtons Principia",es:"Principia de Newton",zh:"牛顿《原理》",ru:"«Начала» Ньютона"} },
  { year:"1789 CE", t:{en:"French Revolution",de:"Französische Revolution",es:"Revolución Francesa",zh:"法国大革命",ru:"Французская революция"} },
  { year:"1859 CE", t:{en:"Darwin: Origin of Species",de:"Darwin: Entstehung der Arten",es:"Darwin: El origen",zh:"达尔文《物种起源》",ru:"Дарвин: Происхождение видов"} },
  { year:"1903 CE", t:{en:"First airplane flight",de:"Erster Flug",es:"Primer vuelo",zh:"首次飞行",ru:"Первый полёт"} },
  { year:"1969 CE", t:{en:"Humans on the Moon",de:"Menschen auf dem Mond",es:"Humanos en la Luna",zh:"人类登月",ru:"Люди на Луне"} },
  { year:"1991 CE", t:{en:"World Wide Web",de:"World Wide Web",es:"World Wide Web",zh:"万维网",ru:"Интернет"} },
];

let lang = 'en';

function setLang(l) {
  lang = l;
  document.querySelectorAll('[data-lang]').forEach(el => el.classList.toggle('active', el.dataset.lang === l));
  document.querySelectorAll('.il[data-l]').forEach(el => el.classList.toggle('active', el.dataset.l === l));
  renderCols();
}

document.getElementById('langSelect').addEventListener('change', e => setLang(e.target.value));

function renderCols() {
  const L = document.getElementById('colLeft');
  const R = document.getElementById('colRight');
  L.innerHTML = ''; R.innerHTML = '';
  const shuffled = [...EVENTS].sort(() => Math.random() - 0.5);
  const half = Math.floor(shuffled.length / 2);
  shuffled.slice(0, half).forEach(e => L.appendChild(makeItem(e)));
  shuffled.slice(half).forEach(e => R.appendChild(makeItem(e)));
  setTimeout(animateCols, 80);
}

function makeItem(e) {
  const d = document.createElement('div');
  d.className = 'era-item';
  const y = document.createElement('span');
  y.className = 'year';
  y.textContent = e.year;
  d.appendChild(y);
  d.appendChild(document.createTextNode(e.t[lang] || e.t.en));
  return d;
}

function animateCols() {
  const items = [...document.querySelectorAll('.era-item')];
  items.forEach(item => {
    setTimeout(() => {
      item.classList.add('visible');
      if (Math.random() > 0.55) item.classList.add('bright');
    }, Math.random() * 2500);
  });

  setInterval(() => {
    document.querySelectorAll('.era-item').forEach(item => {
      if (Math.random() > 0.72) {
        item.classList.remove('visible', 'bright');
        setTimeout(() => {
          if (Math.random() > 0.3) item.classList.add('visible');
          if (Math.random() > 0.55) item.classList.add('bright');
        }, 1800 + Math.random() * 3000);
      }
    });
  }, 3500);
}

document.getElementById('fyear').textContent = new Date().getFullYear();
renderCols();
</script>
</body>
</html>
